PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/gg-matchday
CLUBS_MONGODB_URI=mongodb://127.0.0.1:27017/gg-matchday-clubs
# Optional: override the database name embedded in CLUBS_MONGODB_URI.
CLUBS_DB_NAME=
# Only a Firebase identity with this exact, verified email is granted admin access.
ADMIN_EMAIL=admin@example.com
APP_TIMEZONE=Asia/Kolkata
CHAT_ENABLED=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=


# MongoDB backup operations
# Set these as GitHub Actions repository secrets, not in this file:
# MONGODB_URI=<core Atlas connection string used by the app>
# CLUBS_MONGODB_URI=<actual Clubs Atlas connection string; use the core URI only if both connections intentionally share a cluster>
# BACKUP_ENCRYPTION_KEY=<long random secret used to encrypt backups>
# MONGODB_DATABASE and CLUBS_DB_NAME may be set when URI paths do not define the intended database.
#
# Optional server setting for the Admin > Database Health quota meter:
# MONGODB_STORAGE_QUOTA_MB=512


# Weather API
WEATHER_DEFAULT_CITY=Bengaluru
WEATHER_TIMEZONE=Asia/Kolkata
