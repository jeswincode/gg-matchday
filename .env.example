PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/gg-matchday
CLUBS_MONGODB_URI=mongodb://127.0.0.1:27017/gg-matchday-clubs
# Optional: override the database name embedded in CLUBS_MONGODB_URI.
CLUBS_DB_NAME=
ADMIN_EMAIL=admin@example.com
APP_TIMEZONE=Asia/Kolkata
CHAT_ENABLED=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=


# MongoDB backup operations
# Set these as GitHub Actions repository secrets, not in this file:
# MONGODB_URI=<your Atlas connection string>
# BACKUP_ENCRYPTION_KEY=<long random secret used to encrypt backups>
#
# Optional server setting for the Admin > Database Health quota meter:
# MONGODB_STORAGE_QUOTA_MB=512


# External Football Intelligence
# Keep these server-side. The frontend only talks to /api/world.
API_FOOTBALL_KEY=
FOOTBALL_DEFAULT_LEAGUE=39
FOOTBALL_DEFAULT_SEASON=2026
FOOTBALL_TIMEZONE=Asia/Kolkata
FOOTBALL_DEFAULT_WEATHER_CITY=Bengaluru
FOOTBALL_WORLD_CACHE_SECONDS=300

# Optional external football news/highlights/artwork
NEWSDATA_API_KEY=
SCOREBAT_API_TOKEN=
THE_SPORTS_DB_KEY=
OPENFOOT_API_KEY=
